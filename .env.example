# ============================================
# ZOYA AI Assistant — Environment Variables
# Copy this file to .env and fill in your values
# ============================================
# AI Provider API Keys (add whichever you use)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_AI_API_KEY=your-google-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
# App Configuration
ZOYA_PORT=25809
ZOYA_HOST=127.0.0.1
ZOYA_DATA_DIR=./data
ZOYA_LOG_DIR=./logs
# Backend Configuration
BACKEND_PORT=25810
DATABASE_URL=sqlite:./data/zoya.db
# UI Configuration
VITE_API_URL=http://127.0.0.1:25810
VITE_APP_NAME=ZOYA
# Debug & Logging
DEBUG=false
LOG_LEVEL=info
